{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "overlay-compact", "overlay-popup", "toast"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-focus",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:allow-save",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/**" }
      ]
    },
    "opener:allow-open-path",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "allow-get-db-bootstrap",
    "allow-save-file",
    "allow-update-tray-tooltip",
    "allow-update-tray-icon",
    "allow-update-shortcuts",
    "allow-toggle-overlay",
    "allow-start-oauth-server",
    "allow-post-form-json",
    "allow-get-bearer-json",
    "allow-post-bearer-json",
    "allow-get-platform",
    "allow-get-display-server",
    "allow-open-in-browser",
    "allow-open-in-file-manager",
    "allow-check-for-update",
    "allow-download-and-install-update",
    "allow-relaunch-app",
    "allow-start-local-api",
    "allow-stop-local-api",
    "allow-get-local-api-status",
    "allow-get-pending-deep-link-page",
    "allow-get-pending-start-task",
    "allow-get-pending-retroactive-prefill",
    "allow-log-frontend",
    "allow-backup-db-to-drive"
  ]
}
