GCP_CLIENT_ID=
GCP_CLIENT_SECRET=

# Ids dos dois boards do Monday que a integração lê: o Portfólio, que lista os
# projetos, e o Report de Horas, que guarda o catálogo de rótulos. Descrevem a
# conta, não o produto — por isso saem daqui e não do código. Sem eles o app
# abre com os campos vazios, e a integração pede os dois na tela.
MONDAY_PORTFOLIO_BOARD_ID=
MONDAY_REPORT_BOARD_ID=
